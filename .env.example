# Loop Engineering configuration (all optional; sensible defaults in src/config.ts)

# --- Data / runtime paths ---
# LOOP_DATA_DIR=~/.local/share/loop-engineering        # db, logs, worktrees root
# LOOP_DB_PATH=~/.local/share/loop-engineering/loop.sqlite

# --- Token source (TokenBar) ---
# Point to the TokenBar mcp/ install dir on the HOST so TokenClient reuses usage-core.mjs.
# TOKENBAR_MCP_DIR=/home/you/TokenBar/mcp
# Shared token cache written by TokenBar (kept consistent with the GNOME bar / MCP):
# TOKENBAR_TOKEN_CACHE=~/.config/claude-usage-bar/token
# TOKENBAR_HISTORY=~/.local/share/claude-usage-mcp/history.jsonl

# --- Remote API (M2) ---
# LOOP_API_TOKEN=change-me-long-random    # bearer for the Fastify API
# LOOP_READONLY_TOKEN=change-me-long-random   # 唯讀 bearer：只放行 GET 到 /api/rag /api/knowledge /api/sources /api/status
# LOOP_CORS_ORIGINS=https://board.<tailnet>.ts.net,https://app.<tailnet>.ts.net  # 逗號分隔；空=停用
# LOOP_MCP_PORT=4713                          # 唯讀 SSoT 網路 MCP 埠（Streamable HTTP）
# LOOP_BIND=127.0.0.1
# LOOP_PORT=4711

# --- Notifications (M2) ---
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=loop-eng-<random>

# TokenBar（AddisLu/TokenBar）：把用量讀取交給它的 mcp/usage-core.mjs，
# 並和它共用同一份跨工具快取（含帳號層級的 429 冷卻 blockedUntil）。
# 未設定時沿用內建的移植版讀取。
# TOKENBAR_MCP_DIR=~/Addis/TokenBar/mcp
# LOOP_USAGE_CACHE=~/.local/share/claude-usage/usage-cache.json
